// ================================
// NicolPOS+IMS Database Schema
// Ethiopian POS & Inventory Management System
// Enterprise Edition - Complete
// ================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================
// ENUMS
// ================================

enum UserRoleEnum {
  SUPER_ADMIN
  TENANT_ADMIN
  BRANCH_MANAGER
  CASHIER
  ACCOUNTANT
  INVENTORY_MANAGER
  AUDITOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
  ARCHIVED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  TELEBIRR
  CBEBIRR
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  PENDING_CLEARANCE
  CLEARED
  REJECTED
  CANCELLED
}

enum MovementType {
  OPENING_BALANCE
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
  EXPIRY
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum TaxType {
  VAT
  EXCISE
  ZERO_RATED
  EXEMPT
  OTHER
}

// ================================
// ORGANIZATION
// ================================

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  tinNumber String   @unique @map("tin_number") @db.VarChar(50)
  email     String?  @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  address   String?  @db.Text
  status    String   @default("ACTIVE") @db.VarChar(20)
  
  users             User[]
  branches          Branch[]
  products          Product[]
  sales             Sale[]
  payments          Payment[]
  invoices          Invoice[]
  auditLogs         AuditLog[]
  syncQueue         SyncQueue[]
  warehouses        Warehouse[]
  inventoryBalances InventoryBalance[]
  stockMovements    StockMovement[]
  fiscalSubmissions FiscalSubmission[]
  customers         Customer[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  cashSessions      CashSession[]
  categories        Category[]
  idempotencyKeys   IdempotencyKey[]
  devices           Device[]
  roles             Role[]
  taxRates          TaxRate[]
  salesReturns      SalesReturn[]
  units             Unit[]
  priceLists        PriceList[]
  stockTransfers    StockTransfer[]
  accounts          Account[]
  journalEntries    JournalEntry[]
  securityEvents    SecurityEvent[]
  
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  
  @@map("tenants")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(255)
  code      String   @db.VarChar(50)
  address   String?  @db.Text
  city      String?  @db.VarChar(100)
  phone     String?  @db.VarChar(50)
  status    String   @default("ACTIVE") @db.VarChar(20)
  
  warehouses   Warehouse[]
  sales        Sale[]
  cashSessions CashSession[]
  devices      Device[]
  
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  name      String   @db.VarChar(255)
  code      String   @db.VarChar(50)
  type      String   @default("MAIN") @db.VarChar(20)
  
  inventoryBalances  InventoryBalance[]
  stockMovements     StockMovement[]
  sales              Sale[]
  stockTransfersFrom StockTransfer[] @relation("FromWarehouse")
  stockTransfersTo   StockTransfer[] @relation("ToWarehouse")
  
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  branch    Branch   @relation(fields: [branchId], references: [id])
  
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([branchId])
  @@map("warehouses")
}

// ================================
// IDENTITY & RBAC
// ================================

model User {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  email        String       @unique @db.VarChar(255)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  firstName    String       @map("first_name") @db.VarChar(100)
  lastName     String       @map("last_name") @db.VarChar(100)
  role         UserRoleEnum @default(CASHIER)
  status       UserStatus   @default(ACTIVE)
  phone        String?      @db.VarChar(50)
  
  sales                 Sale[]
  auditLogs             AuditLog[]
  cashSessions          CashSession[]
  userRoleAssignments   UserRoleAssignment[]
  refreshTokens         RefreshToken[]
  securityEvents        SecurityEvent[]
  
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz()
  
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  
  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  
  userRoleAssignments UserRoleAssignment[]
  rolePermissions RolePermission[]
  
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  
  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(100)
  description String?  @db.Text
  module      String   @db.VarChar(50)
  rolePermissions RolePermission[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  @@map("permissions")
}

model UserRoleAssignment {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  assignedAt  DateTime @default(now()) @map("assigned_at") @db.Timestamptz()
  user        User     @relation(fields: [userId], references: [id])
  role        Role     @relation(fields: [roleId], references: [id])
  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

model RolePermission {
  id          String   @id @default(uuid()) @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  permissionId String  @map("permission_id") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz()
  role        Role     @relation(fields: [roleId], references: [id])
  permission  Permission @relation(fields: [permissionId], references: [id])
  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

// ================================
// REFRESH TOKENS
// ================================

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  deviceId  String?  @map("device_id") @db.VarChar(255)
  ipAddress String?  @map("ip_address") @db.VarChar(50)
  userAgent String?  @map("user_agent") @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  user      User     @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ================================
// TAX RATES
// ================================

model TaxRate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(100)
  code        String   @db.VarChar(50)
  rate        Decimal  @db.Decimal(5, 2)
  taxType     TaxType  @default(VAT)
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz()
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz()
  isActive    Boolean  @default(true) @map("is_active")
  products    Product[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("tax_rates")
}

// ================================
// CATALOG
// ================================

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(255)
  code        String?  @db.VarChar(50)
  description String?  @db.Text
  parentId    String?  @map("parent_id") @db.Uuid
  products    Product[]
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("categories")
}

model Unit {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(50)
  symbol      String   @db.VarChar(20)
  precision   Int      @default(2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, name])
  @@map("units")
}

model PriceList {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(100)
  currency    String   @default("ETB") @db.Char(3)
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  productPrices ProductPrice[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, name])
  @@map("price_lists")
}

model ProductPrice {
  id          String   @id @default(uuid()) @db.Uuid
  priceListId String   @map("price_list_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  price       Decimal  @db.Decimal(12, 2)
  minimumQuantity Int  @default(1) @map("minimum_quantity")
  validFrom   DateTime? @map("valid_from") @db.Timestamptz()
  validTo     DateTime? @map("valid_to") @db.Timestamptz()
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  priceList   PriceList @relation(fields: [priceListId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  @@unique([priceListId, productId])
  @@map("product_prices")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  categoryId   String?  @map("category_id") @db.Uuid
  taxRateId    String?  @map("tax_rate_id") @db.Uuid
  sku          String   @db.VarChar(100)
  name         String   @db.VarChar(500)
  barcode      String?  @db.VarChar(100)
  description  String?  @db.Text
  costPrice    Decimal  @default(0) @map("cost_price") @db.Decimal(12, 2)
  sellingPrice Decimal  @default(0) @map("selling_price") @db.Decimal(12, 2)
  quantity     Int      @default(0)
  unit         String   @default("pc") @db.VarChar(20)
  status       ProductStatus @default(ACTIVE)
  saleItems         SaleItem[]
  inventoryBalances InventoryBalance[]
  stockMovements    StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  returnItems       SalesReturnItem[]
  productPrices     ProductPrice[]
  stockTransferItems StockTransferItem[]
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  category     Category? @relation(fields: [categoryId], references: [id])
  taxRate      TaxRate? @relation(fields: [taxRateId], references: [id])
  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([status])
  @@map("products")
}

// ================================
// INVENTORY
// ================================

model InventoryBalance {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
  @@unique([warehouseId, productId])
  @@index([tenantId])
  @@index([productId])
  @@map("inventory_balances")
}

model StockMovement {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  movementType MovementType @map("movement_type")
  quantity    Int
  referenceType String? @map("reference_type") @db.VarChar(50)
  referenceId   String? @map("reference_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
  @@index([tenantId])
  @@index([productId])
  @@index([movementType])
  @@map("stock_movements")
}

model StockTransfer {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  fromWarehouseId String @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String @map("to_warehouse_id") @db.Uuid
  transferNumber  String @map("transfer_number") @db.VarChar(100)
  status      String   @default("PENDING") @db.VarChar(20)
  items       StockTransferItem[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  completedAt DateTime? @map("completed_at") @db.Timestamptz()
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  fromWarehouse Warehouse @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  @@unique([tenantId, transferNumber])
  @@map("stock_transfers")
}

model StockTransferItem {
  id          String   @id @default(uuid()) @db.Uuid
  transferId  String   @map("transfer_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  quantity    Int
  transfer    StockTransfer @relation(fields: [transferId], references: [id])
  product     Product       @relation(fields: [productId], references: [id])
  @@index([transferId])
  @@map("stock_transfer_items")
}

// ================================
// CUSTOMERS & SUPPLIERS
// ================================

model Customer {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  customerType String   @default("INDIVIDUAL") @map("customer_type") @db.VarChar(20)
  name         String   @db.VarChar(255)
  tinNumber    String?  @map("tin_number") @db.VarChar(50)
  phone        String?  @db.VarChar(50)
  email        String?  @db.VarChar(255)
  address      String?  @db.Text
  sales        Sale[]
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  @@map("customers")
}

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String   @db.VarChar(255)
  tinNumber     String?  @map("tin_number") @db.VarChar(50)
  phone         String?  @db.VarChar(50)
  email         String?  @db.VarChar(255)
  address       String?  @db.Text
  contactPerson String?  @map("contact_person") @db.VarChar(255)
  status        String   @default("ACTIVE") @db.VarChar(20)
  purchaseOrders PurchaseOrder[]
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  @@map("suppliers")
}

// ================================
// PURCHASING
// ================================

model PurchaseOrder {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  supplierId  String   @map("supplier_id") @db.Uuid
  orderNumber String   @map("order_number") @db.VarChar(100)
  status      String   @default("DRAFT") @db.VarChar(20)
  subtotal    Decimal  @default(0) @db.Decimal(14, 2)
  taxAmount   Decimal  @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount Decimal  @default(0) @map("total_amount") @db.Decimal(14, 2)
  items       PurchaseOrderItem[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  productId       String        @map("product_id") @db.Uuid
  quantity        Int
  unitCost        Decimal       @map("unit_cost") @db.Decimal(12, 2)
  totalCost       Decimal       @map("total_cost") @db.Decimal(12, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])
  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// ================================
// SALES
// ================================

model Sale {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  branchId    String?  @map("branch_id") @db.Uuid
  warehouseId String?  @map("warehouse_id") @db.Uuid
  cashierId   String   @map("cashier_id") @db.Uuid
  customerId  String?  @map("customer_id") @db.Uuid
  saleNumber  String   @map("sale_number") @db.VarChar(100)
  subtotal    Decimal  @default(0) @db.Decimal(14, 2)
  taxAmount   Decimal  @default(0) @map("tax_amount") @db.Decimal(14, 2)
  discount    Decimal  @default(0) @db.Decimal(14, 2)
  totalAmount Decimal  @default(0) @map("total_amount") @db.Decimal(14, 2)
  status      SaleStatus @default(COMPLETED)
  saleItems   SaleItem[]
  payments    Payment[]
  invoice     Invoice?
  returns     SalesReturn[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  branch      Branch?  @relation(fields: [branchId], references: [id])
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  cashier     User     @relation(fields: [cashierId], references: [id])
  customer    Customer? @relation(fields: [customerId], references: [id])
  @@unique([tenantId, saleNumber])
  @@index([tenantId])
  @@index([branchId])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(uuid()) @db.Uuid
  saleId      String   @map("sale_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(500)
  sku         String   @db.VarChar(100)
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal  @map("total_price") @db.Decimal(12, 2)
  sale        Sale     @relation(fields: [saleId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
  returnItems SalesReturnItem[]
  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  saleId      String   @map("sale_id") @db.Uuid
  method      PaymentMethod
  amount      Decimal  @db.Decimal(14, 2)
  status      PaymentStatus @default(COMPLETED)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  sale        Sale     @relation(fields: [saleId], references: [id])
  @@index([tenantId])
  @@index([saleId])
  @@map("payments")
}

// ================================
// SALES RETURNS
// ================================

model SalesReturn {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  saleId      String   @map("sale_id") @db.Uuid
  returnNumber String  @map("return_number") @db.VarChar(100)
  reason      String?  @db.Text
  status      ReturnStatus @default(PENDING)
  totalAmount Decimal  @default(0) @map("total_amount") @db.Decimal(14, 2)
  items       SalesReturnItem[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  sale        Sale     @relation(fields: [saleId], references: [id])
  @@unique([tenantId, returnNumber])
  @@index([tenantId])
  @@map("sales_returns")
}

model SalesReturnItem {
  id          String   @id @default(uuid()) @db.Uuid
  returnId    String   @map("return_id") @db.Uuid
  saleItemId  String   @map("sale_item_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalAmount Decimal  @map("total_amount") @db.Decimal(12, 2)
  salesReturn SalesReturn @relation(fields: [returnId], references: [id])
  saleItem    SaleItem   @relation(fields: [saleItemId], references: [id])
  product     Product    @relation(fields: [productId], references: [id])
  @@index([returnId])
  @@map("sales_return_items")
}

// ================================
// CASH SESSIONS
// ================================

model CashSession {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  cashierId   String   @map("cashier_id") @db.Uuid
  openingCash Decimal  @default(0) @map("opening_cash") @db.Decimal(14, 2)
  closingCash Decimal? @map("closing_cash") @db.Decimal(14, 2)
  difference  Decimal? @db.Decimal(14, 2)
  status      String   @default("OPEN") @db.VarChar(20)
  openedAt    DateTime @default(now()) @map("opened_at") @db.Timestamptz()
  closedAt    DateTime? @map("closed_at") @db.Timestamptz()
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  branch      Branch   @relation(fields: [branchId], references: [id])
  cashier     User     @relation(fields: [cashierId], references: [id])
  @@index([tenantId])
  @@index([status])
  @@map("cash_sessions")
}

// ================================
// FISCAL
// ================================

model Invoice {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  saleId      String   @unique @map("sale_id") @db.Uuid
  invoiceNumber String @map("invoice_number") @db.VarChar(100)
  status      InvoiceStatus @default(DRAFT)
  irn         String?  @unique @db.VarChar(120)
  rrn         String?  @db.VarChar(120)
  qrPayload   String?  @map("qr_payload") @db.Text
  submissions FiscalSubmission[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  sale        Sale     @relation(fields: [saleId], references: [id])
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([status])
  @@map("invoices")
}

model FiscalSubmission {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  idempotencyKey String @unique @map("idempotency_key") @db.Uuid
  requestPayload  Json  @map("request_payload")
  responsePayload Json? @map("response_payload")
  status      String   @default("PENDING") @db.VarChar(20)
  attemptCount Int     @default(0) @map("attempt_count")
  lastError   String?  @map("last_error") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([status])
  @@map("fiscal_submissions")
}

// ================================
// ACCOUNTING
// ================================

model Account {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  accountCode String   @map("account_code") @db.VarChar(20)
  name        String   @db.VarChar(255)
  accountType String   @map("account_type") @db.VarChar(20)
  parentId    String?  @map("parent_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  children    Account[] @relation("AccountTree")
  parent      Account?  @relation("AccountTree", fields: [parentId], references: [id])
  journalLines JournalLine[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, accountCode])
  @@map("accounts")
}

model JournalEntry {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  entryNumber String   @map("entry_number") @db.VarChar(100)
  description String?  @db.Text
  entryDate   DateTime @map("entry_date") @db.Timestamptz()
  status      String   @default("POSTED") @db.VarChar(20)
  lines       JournalLine[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, entryNumber])
  @@map("journal_entries")
}

model JournalLine {
  id          String   @id @default(uuid()) @db.Uuid
  journalEntryId String @map("journal_entry_id") @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  entryType   String   @map("entry_type") @db.VarChar(10)
  amount      Decimal  @db.Decimal(14, 2)
  description String?  @db.Text
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])
  @@index([journalEntryId])
  @@map("journal_lines")
}

